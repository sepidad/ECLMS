ECLMS_ENVIRONMENT=development
ECLMS_LOG_LEVEL=INFO
ECLMS_JSON_LOGS=true
ECLMS_JWT_SECRET=dev-only-insecure-secret-key-please-rotate-0123456789
ECLMS_JWT_EXPIRE_MINUTES=60
ECLMS_DATABASE_URL=postgresql+asyncpg://eclms:eclms@localhost:5432/eclms
# Connection pool sizing and resilience (PostgreSQL only).
ECLMS_DATABASE_POOL_SIZE=10
ECLMS_DATABASE_MAX_OVERFLOW=20
ECLMS_DATABASE_POOL_PRE_PING=true
ECLMS_DATABASE_POOL_RECYCLE=3600
ECLMS_SCHEDULER_ENABLED=false
ECLMS_ESCALATION_INTERVAL_MINUTES=30
ECLMS_EVENT_TRANSPORT=memory
ECLMS_REDIS_URL=redis://localhost:6379/0
# Set true only when the app runs behind a TLS-terminating reverse proxy.
ECLMS_TRUSTED_PROXY=false

# API hardening. Rate limiting is opt-in; max request body size (bytes, 0=unlimited)
# applies to the Content-Length header.
ECLMS_RATE_LIMIT_ENABLED=false
ECLMS_RATE_LIMIT_REQUESTS=100
ECLMS_RATE_LIMIT_WINDOW_SECONDS=60
ECLMS_MAX_REQUEST_BYTES=0

# Storage backend ('local' filesystem or 's3' object storage).
# For local, only ECLMS_STORAGE_ROOT is required.
ECLMS_STORAGE_ROOT=./var/storage
ECLMS_STORAGE_BACKEND=local
ECLMS_S3_BUCKET=eclms-documents
ECLMS_S3_REGION=us-east-1
# ECLMS_S3_ENDPOINT_URL=https://minio.example.com
# ECLMS_S3_ACCESS_KEY_ID=minio
# ECLMS_S3_SECRET_ACCESS_KEY=minio-secret

# SMTP email delivery (ECLMS_EMAIL_ENABLED=true enables outbound email).
ECLMS_EMAIL_ENABLED=false
ECLMS_SMTP_HOST=localhost
ECLMS_SMTP_PORT=587
ECLMS_SMTP_USER=
ECLMS_SMTP_PASSWORD=
ECLMS_SMTP_FROM=eclms@eclms.local

# OIDC / external identity provider (authorization code flow).
# Set ECLMS_OIDC_ENABLED=true and point at an OIDC-compliant IdP (Keycloak,
# Auth0, Dex, Okta, ...).  New OIDC users are created inactive; an admin must
# activate them and assign roles.
ECLMS_OIDC_ENABLED=false
ECLMS_OIDC_ISSUER=
ECLMS_OIDC_CLIENT_ID=
ECLMS_OIDC_CLIENT_SECRET=
# Comma-separated scopes: openid,email,profile
ECLMS_OIDC_SCOPES=openid,email,profile
ECLMS_OIDC_REDIRECT_URI=
ECLMS_OIDC_DEFAULT_ORG=org-default
